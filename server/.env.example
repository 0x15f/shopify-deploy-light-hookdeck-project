# Bind to localhost unless you intentionally expose the dashboard/API.
HOST=127.0.0.1
PORT=3000

# Leave blank to auto-discover /dev/cu.usbmodem* on macOS.
SERIAL_PORT=
SERIAL_BAUD=115200

# Optional discovery filters. Values are four hexadecimal digits.
# Native USB on many ESP32-C3 boards reports these IDs:
# SERIAL_VID=303a
# SERIAL_PID=1001

# Required only for a directly exposed Hookdeck HTTP destination.
# The authenticated Hookdeck CLI tunnel does not require this local secret.
HOOKDECK_SECRET=

# Optional reliability tuning.
SERIAL_RECONNECT_MIN_MS=1000
SERIAL_RECONNECT_MAX_MS=30000
SERIAL_QUEUE_LIMIT=256
